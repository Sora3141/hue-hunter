rules_version = '2';

// Hue Hunter — Firestore セキュリティルール
// Firebase コンソール > Firestore Database > ルール に貼り付けて「公開」する。
// これを設定しないと rankings_v2 への書き込みが permission-denied で失敗する。

service cloud.firestore {
  match /databases/{database}/documents {

    // シーズン1（旧ルール・アーカイブ）: 読み取り専用
    match /rankings/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // シーズン2（現行）
    match /rankings_v2/{uid} {
      allow read: if true;

      // 自分のドキュメントだけ、形式が正しい場合に限り書き込める
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(
                        ['name', 'score', 'minDelta', 'season', 'timestamp'])
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.name.size() <= 8
                   && request.resource.data.score is int
                   && request.resource.data.score >= 0
                   && request.resource.data.score <= 500
                   && request.resource.data.minDelta is number
                   && request.resource.data.minDelta >= 0
                   && request.resource.data.minDelta <= 360
                   && request.resource.data.season == 2
                   && request.resource.data.timestamp == request.time;
    }
  }
}
